# Public, safe for the browser. Get these from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only key for protected administrative maintenance.
# Never prefix this key with NEXT_PUBLIC_ and never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Configure Google in Supabase Auth before enabling the button.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
